# ==========================================
# FACTORY SUITE PRO - FRONTEND (.env.example)
# ==========================================

# Backend API Server URL
# Set this to your deployed backend URL on Railway/Render/VPS:
REACT_APP_BACKEND_URL=https://reports-backend-pr............

# Multi-User Authentication Configuration
REACT_APP_USERS_CONFIG='[{"id":"admin","name":"Administrator","pas.............."manager","name.,.....role":"Manager","avatarColor":"#059669"},{"id":"supervisor","name":"Stitching Supervisor","password":"123","role":"Supervisor","avatarColor":"#d97706"},{"id":"viewer","name":"Guest Viewer","password":"view","role":"Viewer","avatarColor":"#2563eb"}]'

# Google Sheets API Credentials
REACT_APP_GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# Spreadsheet IDs
REACT_APP_MAIN_SPREADSHEET_ID=YOUR_MAIN_SPREADSHEET_ID
REACT_APP_JOBORDER_SPREADSHEET_ID=YOUR_JOBORDER_SPREADSHEET_ID
REACT_APP_ISSUES_SPREADSHEET_ID=YOUR_ISSUES_SPREADSHEET_ID
REACT_APP_DAILY_STITCHING_SPREADSHEET_ID=YOUR_DAILY_STITCHING_SPREADSHEET_ID
REACT_APP_WORKING_UPDATES_SPREADSHEET_ID=YOUR_WORKING_UPDATES_SPREADSHEET_ID
REACT_APP_ZIP_SPREADSHEET_ID=YOUR_ZIP_SPREADSHEET_ID
REACT_APP_DORI_SPREADSHEET_ID=YOUR_DORI_SPREADSHEET_ID
REACT_APP_RAWPACK_SPREADSHEET_ID=YOUR_RAWPACK_SPREADSHEET_ID

# Sheet Tab Names
REACT_APP_JOB_ORDER_SHEET_NAME=JobOrder
REACT_APP_INDEX_SHEET_NAME=Index
REACT_APP_ISSUES_SHEET_NAME=Issues
REACT_APP_CUTTING_SHEET_NAME=Cutting
REACT_APP_RAWPACK_SHEET_NAME=RAWPACK

# Knitting, Collar & Kora Rolls Report Configuration
REACT_APP_KNITTING_SPREADSHEET_ID=YOUR_KNITTING_SPREADSHEET_ID
REACT_APP_KNITTING_SHEET_RANGE=knitting prod!A1:J1000
REACT_APP_COLLAR_SHEET_RANGE=COLLAR!A1:J1000
REACT_APP_KORA_ROLLS_SHEET_RANGE=kora rolls!A1:H1000
REACT_APP_YARN_SHEET_RANGE=yarn!A1:C1000
REACT_APP_LOT_LOGS_WEBHOOK_URL=YOUR_LOT_LOGS_WEBHOOK_URL
REACT_APP_LOT_LOGS_SPREADSHEET_ID=YOUR_LOT_LOGS_SPREADSHEET_ID
REACT_APP_LOT_LOGS_SHEET_RANGE=LotLogs!A1:H10000

# EMB & PRINT Remarks Webhook & Spreadsheet Configuration
REACT_APP_EMB_PRINT_REMARKS_SPREADSHEET_ID=YOUR_EMB_PRINT_REMARKS_SPREADSHEET_ID
REACT_APP_EMB_PRINT_REMARKS_WEBHOOK_URL=YOUR_EMB_PRINT_REMARKS_WEBHOOK_URL
